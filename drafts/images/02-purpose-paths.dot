digraph G {
  graph [fontname="Noto Sans CJK JP", bgcolor="white", pad="0.4", rankdir=LR, nodesep="0.5", ranksep="1.1", fontsize=20, labelloc=t,
         label=<<b>同じcase-serviceを通っても、リクエストの目的で頼めることが変わる</b><br/><font point-size="13">目的は入口（bff）が刻み、途中の代理人は変えられない。解除の委任状は、解除のリクエストでだけSTSが発行する</font>>];
  node [fontname="Noto Sans CJK JP", fontsize=13, shape=box, style="rounded,filled", fillcolor="#f8fafc", color="#475569", penwidth=1.3];
  edge [fontname="Noto Sans CJK JP", fontsize=11, color="#475569"];

  subgraph cluster_s {
    label=<<b>案件を開く</b>　purpose = case-summary>; fontsize=13; style="rounded,dashed"; color="#dc2626"; fontcolor="#991b1b";
    bff1 [label=<<b>bff</b><br/><font point-size="11">目的を刻む</font>>, fillcolor="#e0f2fe"];
    case1 [label=<case-service<br/><font point-size="10">（乗っ取られていても）</font>>];
    acct1 [label="account-service", fillcolor="#fee2e2"];
  }
  subgraph cluster_u {
    label=<<b>凍結を解除する</b>　purpose = account-unfreeze>; fontsize=13; style="rounded,dashed"; color="#16a34a"; fontcolor="#166534";
    bff2 [label=<<b>bff</b><br/><font point-size="11">目的を刻む</font>>, fillcolor="#e0f2fe"];
    case2 [label="case-service"];
    acct2 [label="account-service", fillcolor="#dcfce7"];
  }

  bff1 -> case1 [label="case:summary"];
  case1 -> acct1 [label=<account:read は発行される<br/><b>account:unfreeze</b> は<br/>STSが発行しない<br/> >, style=dashed, color="#dc2626", fontcolor="#991b1b", penwidth=1.6];
  bff2 -> case2 [label="case:unfreeze"];
  case2 -> acct2 [label=<<b>account:unfreeze</b><br/>STSが発行する>, color="#16a34a", fontcolor="#166534", penwidth=2];
}
