{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": ["infra", "packages/*/src", "packages/*/test", "services/*/src", "services/*/authz.ts", "tests", "web/src", "web/vite.config.ts"],
  "exclude": ["**/node_modules", "**/cdk.out"]
}
