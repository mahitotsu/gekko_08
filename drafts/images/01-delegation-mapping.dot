digraph G {
  graph [fontname="Noto Sans CJK JP", bgcolor="white", pad="0.4", label=<<b>「田中さんの代理で来ました」を、呼び出し元には書き換えられない保証にする</b>>, labelloc=t, fontsize=20];
  node [fontname="Noto Sans CJK JP", shape=plain, fontsize=14];

  t [label=<
  <table border="0" cellborder="1" cellspacing="0" cellpadding="10">
    <tr>
      <td bgcolor="#334155"><font color="white"><b>窓口で求められるもの</b></font></td>
      <td bgcolor="#334155"><font color="white"><b>確かめること</b></font></td>
      <td bgcolor="#334155"><font color="white"><b>gekko_08での形</b></font></td>
      <td bgcolor="#334155"><font color="white"><b>保証する者</b></font></td>
    </tr>
    <tr>
      <td bgcolor="#e0f2fe" align="left" balign="left"><b>委任者の本人確認書類</b></td>
      <td align="left" balign="left">誰の代理か</td>
      <td align="left" balign="left">JWTの <font face="monospace">source_identity</font><br/>（STSのSourceIdentity）</td>
      <td align="left" balign="left">Cognito（IDトークンに署名）<br/>STS（以後書き換えさせない）</td>
    </tr>
    <tr>
      <td bgcolor="#e0f2fe" align="left" balign="left"><b>委任状</b></td>
      <td align="left" balign="left">誰に宛てて、何を頼んだか</td>
      <td align="left" balign="left">JWTの <font face="monospace">aud</font> と scope<br/>（frontendが書く）</td>
      <td align="left" balign="left">STS（JWTに署名）<br/>IAM（書ける中身を限る）</td>
    </tr>
    <tr>
      <td bgcolor="#e0f2fe" align="left" balign="left"><b>代理人の本人確認書類</b></td>
      <td align="left" balign="left">持ってきたのが代理人本人か</td>
      <td align="left" balign="left">実行ロールによるSigV4の署名<br/>（＋JWTの <font face="monospace">sub</font> との対応）</td>
      <td align="left" balign="left">IAM（入口で確かめる）</td>
    </tr>
    <tr>
      <td bgcolor="#f1f5f9" align="left" balign="left"><i>（書類に書かないもの）</i></td>
      <td align="left" balign="left">田中さんにその権利があるか</td>
      <td align="left" balign="left" colspan="2">窓口（backend）が、自分の業務ルールに従って決める</td>
    </tr>
  </table>>];
}
