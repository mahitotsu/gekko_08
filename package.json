{
  "name": "gekko08",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "infra",
    "packages/*",
    "services/*",
    "tests"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run test -w @gekko08/authz-context -w @gekko08/infra",
    "test:scenario": "npm run test -w @gekko08/tests",
    "deploy": "npm run cdk -w @gekko08/infra -- deploy",
    "destroy": "npm run cdk -w @gekko08/infra -- destroy",
    "test:scenario:cloudtrail": "CHECK_CLOUDTRAIL=1 npm run test -w @gekko08/tests"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.160",
    "@types/node": "^22.0.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0"
  }
}
