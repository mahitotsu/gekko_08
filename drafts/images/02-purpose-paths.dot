digraph G {
  graph [fontname="Noto Sans CJK JP", bgcolor="white", pad="0.4", rankdir=LR, nodesep="0.45", ranksep="0.9", fontsize=20, labelloc=t,
         label=<<b>同じホップを通っても、リクエストの目的で委任できる範囲が変わる</b><br/><font point-size="13">目的は入口（bff）がtransitive session tagとして刻み、途中のホップ（エージェントを含む）は変えられない</font>>];
  node [fontname="Noto Sans CJK JP", fontsize=13, shape=box, style="rounded,filled", fillcolor="#f8fafc", color="#475569", penwidth=1.3];
  edge [fontname="Noto Sans CJK JP", fontsize=11, color="#475569"];

  bff [label=<<b>bff</b><br/><font point-size="11">目的を刻む</font>>, fillcolor="#e0f2fe"];

  subgraph cluster_h {
    label=<<b>人間の解除の操作</b>　purpose = account-unfreeze>; fontsize=13; style="rounded,dashed"; color="#16a34a"; fontcolor="#166534";
    case1 [label="case-service"];
    acct1 [label="account-service", fillcolor="#dcfce7"];
  }
  subgraph cluster_a {
    label=<<b>エージェントの分析</b>　purpose = agent-analysis>; fontsize=13; style="rounded,dashed"; color="#dc2626"; fontcolor="#991b1b";
    agent [label=<fraud-agent<br/><font point-size="10">（誘導されうる代理人）</font>>];
    mcp [label="fraud-mcp"];
    case2 [label="case-service"];
    acct2 [label="account-service", fillcolor="#fee2e2"];
  }

  bff -> case1 [label="case:unfreeze"];
  case1 -> acct1 [label=<<b>account:unfreeze</b><br/>STSが発行する>, color="#16a34a", fontcolor="#166534", penwidth=2];
  bff -> agent [label="agent:analyze"];
  agent -> mcp [label="mcp:tools"];
  mcp -> acct2 [label=<unfreeze_account も<br/><b>account:read</b> しか付けられない<br/>→ 403>, color="#dc2626", fontcolor="#991b1b", penwidth=2];
  mcp -> case2 [label="case:read"];
  case2 -> acct2 [label=<<b>account:unfreeze</b> は<br/>STSが発行しない>, style=dashed, color="#dc2626", fontcolor="#991b1b"];
}
