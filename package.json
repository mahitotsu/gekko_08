{
  "name": "gekko08",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "web",
    "infra",
    "packages/*",
    "services/*",
    "tests"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:scenario": "npm run test -w @gekko08/tests",
    "deploy": "npm run cdk -w @gekko08/infra -- deploy",
    "destroy": "npm run cdk -w @gekko08/infra -- destroy",
    "test:scenario:cloudtrail": "CHECK_CLOUDTRAIL=1 npm run test -w @gekko08/tests"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/aws-lambda": "^8.10.160",
    "@types/node": "^24.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
