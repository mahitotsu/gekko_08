{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["infra", "packages/*/src", "packages/*/test", "services/*/src", "tests"],
  "exclude": ["**/node_modules", "**/cdk.out"]
}
