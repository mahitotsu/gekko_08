{
  // サーバー側：Lambdaの関数、共通部品、CDK、テスト。Node.jsの型だけを使い、DOMの型は使わない
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": ["infra", "packages/*/src", "packages/*/test", "services/*/src", "services/*/test", "services/*/authz.ts", "tests", "web/vite.config.ts", "vitest.config.ts", "eslint.config.ts"],
  "exclude": ["**/node_modules", "**/cdk.out"]
}
